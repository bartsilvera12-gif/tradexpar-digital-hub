# Tradexpar — .htaccess de la raíz del repo (public_html en Hostinger).
#
# Hostinger sirve el repositorio Git desde la raíz, pero el build está en dist/.
# Sin este archivo, Apache servía el index.html del template Vite (apunta a
# /src/main.tsx) y la app quedaba en blanco.
#
# Este .htaccess:
#   · Reescribe internamente cualquier request a dist/<path> si existe allí.
#   · El request / se sirve con dist/index.html.
#   · Chunks /assets/*.js|css que no existen → 404 real (NUNCA HTML, para no
#     romper el bundle durante un git pull).
#   · Rutas SPA (/products, /admin…) → dist/index.html.
#   · Bloquea el acceso a archivos de desarrollo (source, server, etc.).

Options +FollowSymLinks -MultiViews

# ---------------------------------------------------------------------------
# Bloqueos de seguridad: nada de código fuente, env ni config.
# ---------------------------------------------------------------------------
<FilesMatch "^(package(-lock)?\.json|tsconfig.*\.json|vite\.config\..*|components\.json|eslint\.config\..*|tailwind\.config\..*|postcss\.config\..*|\.gitignore|\.gitattributes|\.env.*|README.*|.*\.md|Dockerfile.*|yarn\.lock|pnpm-lock\.yaml)$">
  Require all denied
</FilesMatch>

# Carpetas que nunca deben exponerse públicamente.
RewriteEngine On
RewriteBase /
RewriteRule ^(src|server|supabase|node_modules|scripts|docs|tests?|e2e|\.github|\.git)(/|$) - [F,L]

# ---------------------------------------------------------------------------
# Cache headers (aplicados por path real del archivo entregado).
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # index.html NUNCA se cachea para que siempre pida chunks nuevos tras un deploy.
  <FilesMatch "(^|/)index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Assets con hash (Vite) → cacheables 1 año.
  <FilesMatch "\.(js|mjs|css|map|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# MIME types + compresión (por si Hostinger no los trae).
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript  .js .mjs
  AddType text/css                .css
  AddType application/json        .map .json
  AddType font/woff2              .woff2
  AddType image/svg+xml           .svg
  AddType image/webp              .webp
  AddType image/avif              .avif
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Reescritura: todo viene de dist/.
# ---------------------------------------------------------------------------

# Raíz → dist/index.html
RewriteRule ^$ dist/index.html [L]

# Si existe el mismo path dentro de dist/, servirlo desde dist/.
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.+)$ dist/$1 [L]

# Si tampoco existe pero es un asset estático → 404 REAL (evita HTML servido
# como JS/CSS cuando un chunk con hash viejo ya no está).
RewriteCond %{REQUEST_URI} \.(js|mjs|css|map|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico|json|txt)$ [NC]
RewriteRule ^ - [R=404,L]

# Cualquier otra ruta (SPA / React Router) → dist/index.html.
RewriteRule . dist/index.html [L]
